# The server refuses to start if any required value is missing or still a placeholder.

# --- Database (required)
DATABASE_URL=postgresql://registry:registry@localhost:5432/registry

# --- Secrets (required). Store them in a secrets manager; never commit real values.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later makes every stored identifier unsearchable.
IDENTIFIER_HMAC_SECRET=replace-with-64-hex-characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts stored identifiers, TOTP secrets and every evidence file. Losing it loses that data.
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# --- Private evidence bucket (required). Any S3-compatible store: AWS S3, Cloudflare R2, Backblaze B2, SeaweedFS.
# Local docker-compose (SeaweedFS) values shown. Leave S3_ENDPOINT empty for AWS S3.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=claim-evidence
S3_ACCESS_KEY_ID=local-dev
S3_SECRET_ACCESS_KEY=local-dev-only-secret
S3_FORCE_PATH_STYLE=true

# --- Email (required in production; in development login codes are printed to the server log)
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="চোর ছিনতাই <no-reply@your-domain>"

# --- Client IP for rate limiting. Use the header your reverse proxy OVERWRITES:
# cf-connecting-ip (Cloudflare) | x-real-ip (nginx) | x-forwarded-for (Vercel / load balancers, default)
CLIENT_IP_HEADER=x-forwarded-for

# --- Bot protection: Cloudflare Turnstile (required in production; skipped in development when empty)
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Public contact address for privacy, takedown and legal requests (required in production)
NEXT_PUBLIC_CONTACT_EMAIL=
