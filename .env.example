# Leave DATABASE_URL empty for local development: an embedded PGlite database
# is created in .data/pglite. In production, point it at PostgreSQL 15+.
DATABASE_URL=
# Public URL of the site, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production. Generate each with: openssl rand -hex 32
# Never change IDENTIFIER_HMAC_SECRET or FIELD_ENCRYPTION_KEY after launch,
# or existing reports can no longer be searched or decrypted.
IDENTIFIER_HMAC_SECRET=
FIELD_ENCRYPTION_KEY=
SESSION_SECRET=

# Password for the moderator console at /admin (at least 12 characters).
ADMIN_PASSWORD=
