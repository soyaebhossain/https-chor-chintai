{
  "name": "chor-chintai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "user:role": "tsx --conditions=react-server --env-file-if-exists=.env scripts/set-role.ts",
    "storage:init": "tsx --conditions=react-server --env-file-if-exists=.env scripts/storage-init.ts",
    "test:e2e": "playwright test",
    "db:backup": "tsx --conditions=react-server --env-file-if-exists=.env scripts/db-backup.ts",
    "db:restore-test": "tsx --conditions=react-server --env-file-if-exists=.env scripts/db-restore-test.ts",
    "data:purge": "tsx --conditions=react-server --env-file-if-exists=.env scripts/purge-expired.ts",
    "test:live": "playwright test --config playwright.prod.config.ts",
    "user:password": "tsx --conditions=react-server --env-file-if-exists=.env scripts/set-password.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@hookform/resolvers": "^5.7.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
